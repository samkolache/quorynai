# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. This file is committed so you (and future you) know
# which variables the app needs.

# Port the Express server listens on.
PORT=3000

# Where the Vite dev server runs. Used to configure CORS.
FRONTEND_URL=http://localhost:5173

# "development" or "production". Controls how much error detail we leak.
NODE_ENV=development

# --- Supabase ---
# Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=

# Dashboard → Project Settings → API Keys → "Secret key" (or legacy
# "service_role"). BYPASSES Row Level Security. Server-side only, never commit.
SUPABASE_SECRET_KEY=

# --- Phase 5 (leave blank for now) ---
# ANTHROPIC_API_KEY=
